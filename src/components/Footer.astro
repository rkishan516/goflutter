---
const currentYear = new Date().getFullYear();

const links = {
  packages: [
    { name: 'Dolphin CLI', href: 'https://pub.dev/packages/dolphin_cli' },
    { name: 'Flexible Text', href: 'https://pub.dev/packages/flexible_text' },
    { name: 'Whiteboard', href: 'https://pub.dev/packages/whiteboard' },
    { name: 'Scoped Zone', href: 'https://pub.dev/packages/scoped_zone' },
  ],
  resources: [
    { name: 'Documentation', href: 'https://dolphin.goflutter.in/' },
    { name: 'GitHub', href: 'https://github.com/rkishan516' },
    { name: 'pub.dev', href: 'https://pub.dev/publishers/goflutter.in/packages' },
  ],
  company: [
    { name: 'About', href: '/about' },
    { name: 'Packages', href: '/packages' },
  ],
};
---

<footer class="relative mt-auto border-t border-white/10">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/20"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-flutter-blue to-flutter-blue/70 p-2 shadow-lg shadow-flutter-blue/20 group-hover:shadow-flutter-blue/40 transition-shadow">
            <img src="/logo.png" alt="GoFlutter" class="w-full h-full object-contain" />
          </div>
          <span class="text-xl font-bold text-white">GoFlutter</span>
        </a>
        <p class="mt-4 text-sm text-gray-400 leading-relaxed">
          High-quality Flutter packages and tools to streamline your development workflow.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <a
            href="https://github.com/rkishan516"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://pub.dev/publishers/goflutter.in/packages"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="pub.dev"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L1.5 6v12L12 24l10.5-6V6L12 0zm0 2.18l8.25 4.74v9.5L12 21.18l-8.25-4.76v-9.5L12 2.18zM12 6L6 9.46v5.08L12 18l6-3.46V9.46L12 6z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Packages -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Packages</h3>
        <ul class="mt-4 space-y-3">
          {links.packages.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-gray-400 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Resources</h3>
        <ul class="mt-4 space-y-3">
          {links.resources.map(link => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-gray-400 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Navigation</h3>
        <ul class="mt-4 space-y-3">
          {links.company.map(link => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-400 hover:text-white transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-white/10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-gray-500">
          &copy; {currentYear} GoFlutter. All rights reserved.
        </p>
        <p class="text-sm text-gray-500">
          Built with <span class="text-flutter-blue">Astro</span> & <span class="text-flutter-blue">Tailwind CSS</span>
        </p>
      </div>
    </div>
  </div>
</footer>
