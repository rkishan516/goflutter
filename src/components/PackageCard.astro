---
interface Package {
  name: string;
  description: string;
  image: string;
  pubDevUrl: string;
  githubUrl: string;
  docsUrl?: string;
}

interface Props {
  package: Package;
}

const { package: pkg } = Astro.props;
---

<div class="group relative">
  <!-- Gradient border effect -->
  <div class="absolute -inset-0.5 bg-gradient-to-r from-flutter-blue via-purple-500 to-pink-500 rounded-xl opacity-0 group-hover:opacity-100 blur transition-all duration-500 group-hover:duration-200"></div>

  <div class="relative bg-slate-900/90 backdrop-blur-sm rounded-xl border border-white/10 overflow-hidden transition-all duration-300 group-hover:border-transparent">
    <div class="p-6">
      <!-- Header -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gradient-to-br from-slate-800 to-slate-700 p-2.5 shadow-lg">
          <img class="w-full h-full object-contain" src={pkg.image} alt={pkg.name} />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-lg font-semibold text-white group-hover:text-flutter-blue transition-colors">
            {pkg.name}
          </h3>
          <div class="flex items-center gap-2 mt-1">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-flutter-blue/10 text-flutter-blue border border-flutter-blue/20">
              Flutter
            </span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-500/10 text-green-400 border border-green-500/20">
              Open Source
            </span>
          </div>
        </div>
      </div>

      <!-- Description -->
      <p class="mt-4 text-sm text-gray-400 leading-relaxed line-clamp-2">
        {pkg.description}
      </p>

      <!-- Actions -->
      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href={pkg.pubDevUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg text-white bg-flutter-blue hover:bg-flutter-blue/90 shadow-lg shadow-flutter-blue/25 hover:shadow-flutter-blue/40 transition-all duration-200 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0L1.5 6v12L12 24l10.5-6V6L12 0zm0 2.18l8.25 4.74v9.5L12 21.18l-8.25-4.76v-9.5L12 2.18z"/>
          </svg>
          pub.dev
        </a>
        <a
          href={pkg.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg text-gray-300 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
        {pkg.docsUrl && (
          <a
            href={pkg.docsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg text-gray-300 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Docs
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
