---
import Layout from '../layouts/Layout.astro';
import PackageCard from '../components/PackageCard.astro';
import AnimatedBackground from '../components/AnimatedBackground';

export const packages = [
  {
    name: 'Dolphin CLI',
    description: 'A powerful command-line interface to boost your Flutter development workflow.',
    image: '/dolphin.svg',
    pubDevUrl: 'https://pub.dev/packages/dolphin_cli',
    githubUrl: 'https://github.com/rkishan516/dolphin_cli',
    docsUrl: 'https://dolphin.goflutter.in/',
  },
  {
    name: 'Flexible Text',
    description: 'A flexible text widget for Flutter that adapts to various content and layout requirements.',
    image: '/dart.png',
    pubDevUrl: 'https://pub.dev/packages/flexible_text',
    githubUrl: 'https://github.com/rkishan516/flexible_text'
  },
  {
    name: 'Whiteboard',
    description: 'A customizable whiteboard widget for Flutter applications.',
    image: '/dart.png',
    pubDevUrl: 'https://pub.dev/packages/whiteboard',
    githubUrl: 'https://github.com/rkishan516/whiteboard'
  },
  {
    name: 'Scoped Zone',
    description: 'A Flutter package for managing scoped dependencies and state.',
    image: '/dart.png',
    pubDevUrl: 'https://pub.dev/packages/scoped_zone',
    githubUrl: 'https://github.com/rkishan516/scoped_zone'
  }
];
---

<Layout title="Packages">
  <AnimatedBackground client:load />
  <div class="relative">
    <!-- Hero Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-flutter-blue/10 border border-flutter-blue/20 mb-6">
          <svg class="w-4 h-4 text-flutter-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <span class="text-sm font-medium text-flutter-blue">{packages.length} Packages Available</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
          Flutter <span class="text-flutter-blue">Packages</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-gray-300 leading-relaxed">
          Discover our collection of open-source Flutter packages designed to solve common development challenges and boost your productivity.
        </p>
      </div>
    </div>

    <!-- Packages Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {packages.map(pkg => <PackageCard package={pkg} />)}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center">
        <p class="text-gray-400 mb-6">
          All packages are available on pub.dev and open source on GitHub.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://pub.dev/publishers/goflutter.in/packages"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-base font-medium rounded-lg text-white bg-flutter-blue hover:bg-flutter-blue/90 shadow-lg shadow-flutter-blue/25 hover:shadow-flutter-blue/40 transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L1.5 6v12L12 24l10.5-6V6L12 0zm0 2.18l8.25 4.74v9.5L12 21.18l-8.25-4.76v-9.5L12 2.18z"/>
            </svg>
            View All on pub.dev
          </a>
          <a
            href="https://github.com/rkishan516"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 text-base font-medium rounded-lg text-gray-300 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all duration-200 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            Contribute on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
